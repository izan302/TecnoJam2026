        { "key": "minesweeper_start", "value": "INICIAR"},
        { "key": "minesweeper_title", "value": "<color=red>BUSCA</color>MINAS"},
        { "key": "minesweeper_victory", "value": "Victoria"},
        { "key": "minesweeper_gameOver", "value": "Has Perdido"},
        { "key": "minesweeper_restart", "value": "REINICIAR"},
        { "key": "minesweeper_menu", "value": "MENU"},


        { "key": "tut_01", "value": "Bienvenido al mejor <size=50%><color=grey>(y único)</color></size> software de desarrollo aprobado por el gobierno." },
        { "key": "tut_02", "value": "Para desarrollar tu juego, tienes que colocar los componentes de la <color=#06EF06>cuadrícula</color> de la izquierda" },
        { "key": "tut_03", "value": "de manera que encajen y sin dejar ningún hueco en la <color=red>cuadrícula</color> de la derecha." },
        { "key": "tut_04", "value": "Cada componente tiene sus propiedades, que se mostrarán al seleccionar el componente en la <color=orange>pantalla</color>." },
        { "key": "tut_05", "value": "Todo juego necesita 4 componentes: <color=purple>Mecánicas</color>, <color=#946B1F>Género</color>, <color=#E5C16F>Estilo</color> y un <color=#5D69A9>Ítem</color>. Sabrás cuál es cuál por la pantalla o por el color del componente." },
        { "key": "tut_06", "value": "Para mover los componentes sólo tienes que hacer <size=90%><b>click</b></size> en ellos. Una vez seleccionados puedes rotarlos con las teclas <size=90%><b>Q</b></size> y <size=90%><b>E</b></size>." },
        { "key": "tut_07", "value": "y moverlos con las teclas <size=90%><b>W</b></size>, <size=90%><b>A</b></size>, <size=90%><b>S</b></size>, <size=90%><b>D</b></size>." },
        { "key": "tut_08", "value": "Para confirmar la posición de los componentes en la cuadrícula usa la <size=90%><b>barra espaciadora</b></size>" },
        { "key": "tut_09", "value": "y si cambias de idea puedes devolver el componente a la cuadrícula de la izquierda con el <size=90%><b>click derecho</b></size> mientras lo tienes seleccionado." },
        { "key": "tut_10", "value": "Buena suerte." },
        { "key": "tut_angry", "value": "<size=120%><color=red>¡PARA YA!</color></size>\n¿NO VES QUE NO PUEDES PONERLO?" },


        { "key": "error_83_title", "value": "ERROR(83): CuadrículaIncompleta" },
        { "key": "error_83_message", "value": "La cuadrícula aún no está llena. \nPor favor, complétala antes de enviar." },
              
        { "key": "error_155_title", "value": "ERROR(155): ComponenteProhibido" },
        { "key": "error_155_message", "value": "Hay una pieza prohibida en el juego. \nPor favor, ELIMÍNALA antes de enviar." },
              
        { "key": "error_40_title", "value": "ERROR(40): GéneroNoEncontrado" },
        { "key": "error_40_message", "value": "No existe un Género en el juego. \nPor favor, añade un Género antes de enviar." },
              
        { "key": "error_41_title", "value": "ERROR(41): MecánicaNoEncontrada" },
        { "key": "error_41_message", "value": "No existe una Mecánica en el juego. \nPor favor, añade una Mecánica antes de enviar." },
              
        { "key": "error_42_title", "value": "ERROR(42): EstiloNoEncontrado" },
        { "key": "error_42_message", "value": "No existe un Estilo en el juego. \nPor favor, añade un Estilo antes de enviar." },
              
        { "key": "error_43_title", "value": "ERROR(43): ÍtemNoEncontrado" },
        { "key": "error_43_message", "value": "No existe un Ítem en el juego. \nPor favor, añade un Ítem antes de enviar." },

        
